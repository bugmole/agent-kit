{
  "name": "bugmole-agent-kit",
  "version": "0.1.0",
  "description": "Build a coding agent that Bugmole workers can hand tasks to: the protocol, a server and CLI helper, a client, and a conformance check.",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/theaiinc/bugmole-agent-kit.git" },
  "homepage": "https://github.com/theaiinc/bugmole-agent-kit#readme",
  "keywords": ["bugmole", "coding-agent", "agent", "protocol"],
  "engines": { "node": ">=20" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./server": { "types": "./dist/server.d.ts", "default": "./dist/server.js" },
    "./client": { "types": "./dist/client.d.ts", "default": "./dist/client.js" },
    "./cli": { "types": "./dist/cli-agent.d.ts", "default": "./dist/cli-agent.js" }
  },
  "bin": { "bugmole-agent-kit": "./dist/bin.js" },
  "files": ["dist", "PROTOCOL.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
